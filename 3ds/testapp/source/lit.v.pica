; Per-vertex lit + textured shader (prototype of the port's "Lit" material preset).
; out color = ambient + diffuse * max(0, N.L); the TEV then modulates by the texture.

.fvec projection[4], modelView[4]
.fvec lightDir, lightColor, ambient

.constf consts(0.0, 1.0, -1.0, 0.5)
.alias zeros consts.xxxx
.alias ones  consts.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intex v1
.alias innrm v2

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mov outtc0, intex

	; view-space normal (modelView has no non-uniform scale in this test)
	mov r0.xyz, innrm
	mov r0.w,   zeros
	dp4 r2.x, modelView[0], r0
	dp4 r2.y, modelView[1], r0
	dp4 r2.z, modelView[2], r0
	mov r2.w, zeros
	dp3 r3, r2, r2
	rsq r3, r3
	mul r2, r3, r2

	; diffuse = max(0, dot(N, -lightDir))
	dp3 r3.x, -lightDir, r2
	max r3, zeros, r3

	mul r4, lightColor, r3.xxxx
	add r4, ambient, r4
	min r4, ones, r4
	mov r4.w, ones
	mov outclr, r4
	end
.end
