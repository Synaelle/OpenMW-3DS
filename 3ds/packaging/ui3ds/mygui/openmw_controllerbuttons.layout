<?xml version="1.0" encoding="UTF-8"?>

<!-- M17: the button hints on the 3DS, a strip at the bottom of the bottom screen (the bottom-screen windows end
     above it). The 3DS glyphs (tools/make_button_icons.py) are set by ControllerButtonsOverlay; R3 is SELECT. -->
<MyGUI type="Layout">
    <Widget type="Window" skin="BlackBG" layer="ControllerButtons" position="40 462 320 18" name="_Main">
        <Property key="Visible" value="false"/>
        <Widget type="HBox" position="0 1 320 17" align="Stretch" name="ButtonBox">
            <Property key="Padding" value="0"/>
            <Property key="Spacing" value="6"/>
            <Widget type="Spacer"/>
            <Widget type="HBox" name="BtnDpad">
                <Property key="Padding" value="0"/>
                <Property key="Spacing" value="2"/>
                <Widget type="ImageBox" skin="ImageBox" align="Center" position="0 0 16 16" name="BtnDpadImage">
                    <Property key="Colour" value="#ccb589"/>
                </Widget>
                <Widget type="AutoSizedTextBox" skin="SandText" name="BtnDpadText">
                    <Property key="FontName" value="HintFont"/>
                    <Property key="Caption" value=""/>
                    <Property key="ReadOnly" value="true"/>
                </Widget>
            </Widget>
            <Widget type="HBox" name="BtnA">
                <Property key="Padding" value="0"/>
                <Property key="Spacing" value="2"/>
                <Widget type="ImageBox" skin="ImageBox" align="Center" position="0 0 16 16" name="BtnAImage">
