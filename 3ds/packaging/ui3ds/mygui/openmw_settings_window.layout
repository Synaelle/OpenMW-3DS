<?xml version="1.0" encoding="UTF-8"?>

<!-- The options window on the bottom screen (M8, the tester's design): Prefs (the difficulty...), Visuals and
     Audio (a Controls tab: docs/PLANNED_FEATURES.md). settingswindow.cpp binds many more
     widgets by name: they live hidden in Hidden3DS, where its code can set them up without showing them. The
     root's coordinates are the canvas's (the bottom screen at 40,240); it ends above the button hint strip. -->
<MyGUI type="Layout">
    <Widget type="Window" skin="MW_Window" layer="Settings" position="40 240 320 222" name="_Main">
        <!-- Solid: MW_Window's background follows "menu transparency" and showed the HUD through (the tester).
             DialogBG is the same colour on an opaque texture. -->
        <Widget type="Widget" skin="DialogBG" position="0 0 312 196" align="Stretch">
            <Property key="NeedMouse" value="false"/>
        </Widget>
        <Widget type="TabControl" skin="TabControl" position="4 4 292 158" name="SettingsTab" align="Left Top">
            <Widget type="TabItem">
                <Property key="Caption" value=" #{OMWEngine:Preferences} "/>
                <Widget type="TextBox" skin="NormalText" position="4 4 284 18" align="Left Top" name="DifficultyText">
                    <Property key="Caption" value="#{OMWEngine:Difficulty}"/>
                </Widget>
                <Widget type="ScrollBar" skin="MW_HScroll" position="4 24 280 16" align="Left Top">
                    <Property key="Range" value="201"/>
                    <Property key="Page" value="1"/>
                    <Property key="WheelPage" value="1"/>
                    <UserString key="SettingType" value="Slider"/>
                    <UserString key="SettingCategory" value="Game"/>
                    <UserString key="SettingName" value="difficulty"/>
                    <UserString key="SettingValueType" value="Integer"/>
                    <UserString key="SettingMin" value="-100"/>
                    <UserString key="SettingMax" value="100"/>
                </Widget>
                <Widget type="TextBox" skin="SandText" position="4 41 140 16" align="Left Top">
                    <Property key="Caption" value="#{OMWEngine:DifficultyEasy}"/>
                    <Property key="TextAlign" value="Left"/>
                </Widget>
                <Widget type="TextBox" skin="SandText" position="130 41 150 16" align="Left Top">
                    <Property key="Caption" value="#{OMWEngine:DifficultyHard}"/>
                    <Property key="TextAlign" value="Right"/>
                </Widget>
                <!-- The HUD's minimap (3DS setting [Map] minimap) -->
                <Widget type="HBox" position="4 62 280 26">
                    <Widget type="AutoSizedButton" skin="MW_Button" position="0 0 24 24" align="Left Top">
                        <UserString key="SettingCategory" value="Map"/>
                        <UserString key="SettingName" value="minimap"/>
                        <UserString key="SettingType" value="CheckButton"/>
                    </Widget>
                    <Widget type="AutoSizedTextBox" skin="SandText" position="28 4 95 16" align="Left Top">
                        <Property key="Caption" value="#{OMW3DS:Minimap}"/>
                    </Widget>
                </Widget>
                <!-- Skyrim-like small bars on the top screen (3DS setting [HUD] top bars) -->
                <Widget type="HBox" position="4 90 280 26">
                    <Widget type="AutoSizedButton" skin="MW_Button" position="0 0 24 24" align="Left Top">
                        <UserString key="SettingCategory" value="HUD"/>
                        <UserString key="SettingName" value="top bars"/>
                        <UserString key="SettingType" value="CheckButton"/>
                    </Widget>
                    <Widget type="AutoSizedTextBox" skin="SandText" position="28 4 95 16" align="Left Top">
                        <Property key="Caption" value="#{OMW3DS:TopBars}"/>
                    </Widget>
                </Widget>
            </Widget>
            <Widget type="TabItem">
                <Property key="Caption" value=" #{OMW3DS:Visuals} "/>
                <!-- Small details drawn further away (3DS setting [Camera] far small details; off: the 3DS's small
                     feature culling size, more frame rate in towns) -->
                <Widget type="HBox" position="4 4 280 26">
                    <Widget type="AutoSizedButton" skin="MW_Button" position="0 0 24 24" align="Left Top">
                        <UserString key="SettingCategory" value="Camera"/>
                        <UserString key="SettingName" value="far small details"/>
                        <UserString key="SettingType" value="CheckButton"/>
                    </Widget>
                    <Widget type="AutoSizedTextBox" skin="SandText" position="28 4 95 16" align="Left Top">
                        <Property key="Caption" value="#{OMW3DS:FarSmallDetails}"/>
                    </Widget>
                </Widget>
            </Widget>
            <Widget type="TabItem">
                <Property key="Caption" value=" #{OMWEngine:Audio} "/>
                <Widget type="TextBox" skin="NormalText" position="4 4 100 18" align="Left Top">
                    <Property key="Caption" value="#{OMWEngine:AudioMaster}"/>
                </Widget>
                <Widget type="ScrollBar" skin="MW_HScroll" position="104 5 176 16" align="Left Top">
                    <Property key="Range" value="10000"/>
                    <Property key="Page" value="300"/>
                    <Property key="WheelPage" value="300"/>
                    <UserString key="SettingType" value="Slider"/>
                    <UserString key="SettingCategory" value="Sound"/>
                    <UserString key="SettingName" value="master volume"/>
                    <UserString key="SettingValueType" value="Float"/>
                </Widget>
                <Widget type="TextBox" skin="NormalText" position="4 27 100 18" align="Left Top">
                    <Property key="Caption" value="#{OMWEngine:AudioVoice}"/>
                </Widget>
                <Widget type="ScrollBar" skin="MW_HScroll" position="104 28 176 16" align="Left Top">
                    <Property key="Range" value="10000"/>
                    <Property key="Page" value="300"/>
                    <Property key="WheelPage" value="300"/>
                    <UserString key="SettingType" value="Slider"/>
                    <UserString key="SettingCategory" value="Sound"/>
                    <UserString key="SettingName" value="voice volume"/>
                    <UserString key="SettingValueType" value="Float"/>
                </Widget>
                <Widget type="TextBox" skin="NormalText" position="4 50 100 18" align="Left Top">
                    <Property key="Caption" value="#{OMWEngine:AudioEffects}"/>
                </Widget>
                <Widget type="ScrollBar" skin="MW_HScroll" position="104 51 176 16" align="Left Top">
                    <Property key="Range" value="10000"/>
                    <Property key="Page" value="300"/>
                    <Property key="WheelPage" value="300"/>
                    <UserString key="SettingType" value="Slider"/>
                    <UserString key="SettingCategory" value="Sound"/>
                    <UserString key="SettingName" value="sfx volume"/>
                    <UserString key="SettingValueType" value="Float"/>
                </Widget>
                <Widget type="TextBox" skin="NormalText" position="4 73 100 18" align="Left Top">
                    <Property key="Caption" value="#{OMWEngine:AudioFootsteps}"/>
                </Widget>
                <Widget type="ScrollBar" skin="MW_HScroll" position="104 74 176 16" align="Left Top">
                    <Property key="Range" value="10000"/>
                    <Property key="Page" value="300"/>
                    <Property key="WheelPage" value="300"/>
                    <UserString key="SettingType" value="Slider"/>
                    <UserString key="SettingCategory" value="Sound"/>
                    <UserString key="SettingName" value="footsteps volume"/>
                    <UserString key="SettingValueType" value="Float"/>
                </Widget>
                <Widget type="TextBox" skin="NormalText" position="4 96 100 18" align="Left Top">
                    <Property key="Caption" value="#{OMWEngine:AudioMusic}"/>
                </Widget>
                <Widget type="ScrollBar" skin="MW_HScroll" position="104 97 176 16" align="Left Top">
                    <Property key="Range" value="10000"/>
                    <Property key="Page" value="300"/>
                    <Property key="WheelPage" value="300"/>
                    <UserString key="SettingType" value="Slider"/>
                    <UserString key="SettingCategory" value="Sound"/>
                    <UserString key="SettingName" value="music volume"/>
                    <UserString key="SettingValueType" value="Float"/>
                </Widget>
            </Widget>
        </Widget>
        <Widget type="AutoSizedButton" skin="MW_Button" position="236 166 60 24" name="OkButton" align="Left Top">
            <Property key="ExpandDirection" value="Left"/>
            <Property key="Caption" value="#{Interface:OK}"/>
        </Widget>
        <!-- settingswindow.cpp's other widgets, never shown -->
        <Widget type="Widget" skin="" position="0 0 2 2" name="Hidden3DS">
            <Property key="Visible" value="false"/>
            <Widget type="ListBox" skin="MW_List" position="0 0 2 2" name="ResolutionList"/>
            <Widget type="ComboBox" skin="MW_ComboBox" position="0 0 2 2" name="WindowModeList">
                <Property key="AddItem" value="#{OMWEngine:WindowModeFullscreen}"/>
                <Property key="AddItem" value="#{OMWEngine:WindowModeWindowedFullscreen}"/>
                <Property key="AddItem" value="#{OMWEngine:WindowModeWindowed}"/>
            </Widget>
            <Widget type="ComboBox" skin="MW_ComboBox" position="0 0 2 2" name="VSyncModeList">
                <Property key="AddItem" value="#{Interface:Off}"/>
                <Property key="AddItem" value="#{Interface:On}"/>
                <Property key="AddItem" value="#{OMWEngine:VSyncAdaptive}"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" position="0 0 2 2" name="WindowBorderButton"/>
            <Widget type="ComboBox" skin="MW_ComboBox" position="0 0 2 2" name="TextureFilteringButton">
                <Property key="AddItem" value="#{OMWEngine:TextureFilteringBilinear}"/>
                <Property key="AddItem" value="#{OMWEngine:TextureFilteringTrilinear}"/>
            </Widget>
            <Widget type="ComboBox" skin="MW_ComboBox" position="0 0 2 2" name="Anisotropy">
                <Property key="AddItem" value="#{Interface:Off}"/>
                <Property key="AddItem" value="2x"/>
                <Property key="AddItem" value="4x"/>
                <Property key="AddItem" value="8x"/>
                <Property key="AddItem" value="16x"/>
            </Widget>
            <Widget type="ScrollView" skin="MW_ScrollView" position="0 0 2 2" name="ControlsBox"/>
            <Widget type="AutoSizedButton" skin="MW_Button" position="0 0 2 2" name="ResetControlsButton"/>
            <Widget type="AutoSizedButton" skin="MW_Button" position="0 0 2 2" name="KeyboardButton"/>
            <Widget type="AutoSizedButton" skin="MW_Button" position="0 0 2 2" name="ControllerButton"/>
            <Widget type="AutoSizedButton" skin="MW_Button" position="0 0 2 2" name="WaterRefractionButton"/>
            <Widget type="ComboBox" skin="MW_ComboBox" position="0 0 2 2" name="WaterTextureSize">
                <Property key="AddItem" value="#{OMWEngine:QualityLow}"/>
                <Property key="AddItem" value="#{OMWEngine:QualityMedium}"/>
                <Property key="AddItem" value="#{OMWEngine:QualityHigh}"/>
            </Widget>
            <Widget type="ComboBox" skin="MW_ComboBox" position="0 0 2 2" name="WaterReflectionDetail">
                <Property key="AddItem" value="#{OMWEngine:ReflectionShaderDetailSky}"/>
                <Property key="AddItem" value="#{OMWEngine:ReflectionShaderDetailTerrain}"/>
                <Property key="AddItem" value="#{OMWEngine:ReflectionShaderDetailWorld}"/>
                <Property key="AddItem" value="#{OMWEngine:ReflectionShaderDetailObjects}"/>
                <Property key="AddItem" value="#{OMWEngine:ReflectionShaderDetailActors}"/>
                <Property key="AddItem" value="#{OMWEngine:ReflectionShaderDetailGroundcover}"/>
            </Widget>
            <Widget type="ComboBox" skin="MW_ComboBox" position="0 0 2 2" name="WaterRainRippleDetail">
                <Property key="AddItem" value="#{OMWEngine:RainRippleDetailSimple}"/>
                <Property key="AddItem" value="#{OMWEngine:RainRippleDetailSparse}"/>
                <Property key="AddItem" value="#{OMWEngine:RainRippleDetailDense}"/>
            </Widget>
            <Widget type="ComboBox" skin="MW_ComboBox" position="0 0 2 2" name="PrimaryLanguage" />
            <Widget type="ComboBox" skin="MW_ComboBox" position="0 0 2 2" name="SecondaryLanguage" />
            <Widget type="AutoSizedButton" skin="MW_Button" position="0 0 2 2" name="GmstOverridesL10nButton"/>
            <Widget type="AutoSizedTextBox" skin="SandText" position="0 0 2 2" name="WindowModeHint"/>
            <Widget type="AutoSizedButton" skin="MW_Button" position="0 0 2 2" name="ClusteredLightingButton"/>
            <Widget type="AutoSizedButton" skin="MW_Button" position="0 0 2 2" name="LightsResetButton"/>
            <Widget type="ComboBox" skin="MW_ComboBox" position="0 0 2 2" name="MaxLights">
                <Property key="AddItem" value="8"/>
                <Property key="AddItem" value="16"/>
                <Property key="AddItem" value="24"/>
                <Property key="AddItem" value="32"/>
                <Property key="AddItem" value="40"/>
                <Property key="AddItem" value="48"/>
                <Property key="AddItem" value="56"/>
                <Property key="AddItem" value="64"/>
            </Widget>
            <Widget type="EditBox" skin="MW_TextEdit" position="0 0 2 2" name="ScriptFilter"/>
            <Widget type="ListBox" skin="MW_List" position="0 0 2 2" name="ScriptList"/>
            <Widget type="Widget" skin="" position="0 0 2 2" name="ScriptBox"/>
            <Widget type="ScrollView" skin="MW_ScrollViewVH" position="0 0 2 2" name="ScriptView"/>
            <Widget type="LuaAdapter" skin="" position="0 0 2 2" name="ScriptAdapter"/>
            <Widget type="EditBox" skin="SandText" position="0 0 2 2" name="ScriptDisabled"/>
            <Widget type="HBox" skin="" position="0 0 2 2" name="ClassicFalloffWidget"/>
            <Widget type="TextBox" skin="NormalText" position="0 0 2 2" name="MinimumBrightnessText"/>
            <Widget type="ScrollBar" skin="MW_HScroll" position="0 0 2 2" name="MinimumBrightnessScroll"/>
            <Widget type="AutoSizedButton" skin="MW_Button" position="0 0 2 2" name="ActorShadowsButton"/>
            <Widget type="AutoSizedButton" skin="MW_Button" position="0 0 2 2" name="PlayerShadowsButton"/>
            <Widget type="AutoSizedButton" skin="MW_Button" position="0 0 2 2" name="TerrainShadowsButton"/>
            <Widget type="AutoSizedButton" skin="MW_Button" position="0 0 2 2" name="ObjectShadowsButton"/>
            <Widget type="ComboBox" skin="MW_ComboBox" position="0 0 2 2" name="ShadowMapResolution">
                <Property key="AddItem" value="512"/>
                <Property key="AddItem" value="1024"/>
                <Property key="AddItem" value="2048"/>
                <Property key="AddItem" value="4096"/>
            </Widget>
            <Widget type="ScrollBar" skin="MW_HScroll" position="0 0 2 2" name="GammaSlider"/>
            <Widget type="TextBox" skin="NormalText" position="0 0 2 2" name="GammaText"/>
            <Widget type="TextBox" skin="SandText" position="0 0 2 2" name="GammaTextDark"/>
            <Widget type="TextBox" skin="SandText" position="0 0 2 2" name="GammaTextLight"/>
            <Widget type="ScrollBar" skin="MW_HScroll" position="0 0 2 2" name="RenderingDistanceSlider"/>
            <Widget type="ScrollBar" skin="MW_HScroll" position="0 0 2 2" name="LargeRenderingDistanceSlider"/>
        </Widget>
    </Widget>
</MyGUI>
