<?xml version="1.0" encoding="UTF-8"?>

<!-- The create-class window on the top screen (3DS): 400x240 (center() leaves windows wider than the bottom
     screen at the top), used with the circle pad's pointer and A, as the dialogue window (the tester, test #92).
     The name is typed on the system keyboard (A on the name box); the description button is hidden by class.cpp.
     The widget names are those of class.cpp. -->
<MyGUI type="Layout">
    <Widget type="Window" skin="MW_Dialog" layer="Modal" position="0 0 400 240" name="_Main">
        <!-- Class name -->
        <Widget type="TextBox" skin="NormalText" position="8 6 50 22" name="LabelT" align="Left Top">
            <Property key="Caption" value="#{sName}:"/>
            <Property key="TextAlign" value="Left VCenter"/>
        </Widget>
        <Widget type="EditBox" skin="MW_TextEdit" position="60 6 332 22" name="EditName" align="Left Top">
            <Property key="Caption" value="#{sCustomClassName}"/>
            <Property key="Static" value="true"/>
        </Widget>

        <Widget type="Widget" skin="" position="8 34 384 166" align="Left Top">
            <!-- Specialization -->
            <Widget type="TextBox" skin="HeaderText" position="0 0 190 17" name="SpecializationT" align="Left Top">
                <Property key="Caption" value="#{sChooseClassMenu1}"/>
                <Property key="TextAlign" value="Left Top"/>
            </Widget>
            <Widget type="Button" skin="SandTextButton" position="0 17 190 17" name="SpecializationName" align="Left Top">
                <Property key="TextAlign" value="Left Top"/>
            </Widget>

            <!-- Favorite Attributes -->
            <Widget type="TextBox" skin="HeaderText" position="194 0 190 17" name="FavoriteAttributesT" align="Left Top">
                <Property key="Caption" value="#{sChooseClassMenu2}"/>
                <Property key="TextAlign" value="Left Top"/>
            </Widget>
            <Widget type="MWAttribute" skin="MW_StatNameButton" position="194 17 190 17" name="FavoriteAttribute0" align="Left Top"/>
            <Widget type="MWAttribute" skin="MW_StatNameButton" position="194 34 190 17" name="FavoriteAttribute1" align="Left Top"/>

            <!-- Major Skills -->
            <Widget type="TextBox" skin="HeaderText" position="0 58 190 17" name="MajorSkillT" align="Left Top">
                <Property key="Caption" value="#{sChooseClassMenu3}"/>
                <Property key="TextAlign" value="Left Top"/>
            </Widget>
            <Widget type="MWSkill" skin="MW_StatNameButton" position="0 75 190 17" name="MajorSkill0" align="Left Top"/>
            <Widget type="MWSkill" skin="MW_StatNameButton" position="0 92 190 17" name="MajorSkill1" align="Left Top"/>
            <Widget type="MWSkill" skin="MW_StatNameButton" position="0 109 190 17" name="MajorSkill2" align="Left Top"/>
            <Widget type="MWSkill" skin="MW_StatNameButton" position="0 126 190 17" name="MajorSkill3" align="Left Top"/>
            <Widget type="MWSkill" skin="MW_StatNameButton" position="0 143 190 17" name="MajorSkill4" align="Left Top"/>

            <!-- Minor Skills -->
            <Widget type="TextBox" skin="HeaderText" position="194 58 190 17" name="MinorSkillT" align="Left Top">
                <Property key="Caption" value="#{sChooseClassMenu4}"/>
                <Property key="TextAlign" value="Left Top"/>
            </Widget>
            <Widget type="MWSkill" skin="MW_StatNameButton" position="194 75 190 17" name="MinorSkill0" align="Left Top"/>
            <Widget type="MWSkill" skin="MW_StatNameButton" position="194 92 190 17" name="MinorSkill1" align="Left Top"/>
            <Widget type="MWSkill" skin="MW_StatNameButton" position="194 109 190 17" name="MinorSkill2" align="Left Top"/>
            <Widget type="MWSkill" skin="MW_StatNameButton" position="194 126 190 17" name="MinorSkill3" align="Left Top"/>
            <Widget type="MWSkill" skin="MW_StatNameButton" position="194 143 190 17" name="MinorSkill4" align="Left Top"/>
        </Widget>

        <!-- Dialog buttons (the description one is hidden on the 3DS: class.cpp) -->
        <Widget type="HBox" position="0 208 392 26">
            <Widget type="Spacer"/>
            <Widget type="AutoSizedButton" skin="MW_Button" name="DescriptionButton">
                <Property key="Caption" value="#{sCreateClassMenu1}"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" name="BackButton">
                <Property key="Caption" value="#{sBack}"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" name="OKButton">
                <Property key="Caption" value="#{Interface:OK}"/>
            </Widget>
        </Widget>
    </Widget>
</MyGUI>
