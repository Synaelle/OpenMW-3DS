<?xml version="1.0" encoding="UTF-8"?>

<!-- The barter window on the top screen (the tester, test #74: as the container window): the merchant's items, the
     deal and its buttons here, used with the circle pad's cursor; the player's inventory as the bottom screen's
     Inventory tab, whose Sell button offers the selected item (n3ds/hud3ds.cpp). The widget names are those of
     tradewindow.cpp. -->
<MyGUI type="Layout">
    <Widget type="Window" skin="MW_Window" layer="Windows" position="0 0 400 240" name="_Main">
        <Property key="Visible" value="false"/>

        <!-- Categories -->
        <Widget type="HBox" position="4 4 372 22" align="Left Top HStretch" name="Categories">
            <Property key="Spacing" value="4"/>
            <Widget type="ImageBox" skin="ImageBox" position="0 3 16 16" align="VCenter" name="BtnL1Image">
                <Property key="Colour" value="#ccb589"/>
                <Property key="Visible" value="false"/>
                <UserString key="Hidden" value="true"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" name="AllButton">
                <Property key="Caption" value="#{sAllTab}"/>
                <Property key="NeedKey" value="false"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" name="WeaponButton">
                <Property key="Caption" value="#{sWeaponTab}"/>
                <Property key="NeedKey" value="false"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" name="ApparelButton">
                <Property key="Caption" value="#{sApparelTab}"/>
                <Property key="NeedKey" value="false"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" name="MagicButton">
                <Property key="Caption" value="#{sMagicTab}"/>
                <Property key="NeedKey" value="false"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" name="MiscButton">
                <Property key="Caption" value="#{sMiscTab}"/>
                <Property key="NeedKey" value="false"/>
            </Widget>
            <Widget type="ImageBox" skin="ImageBox" position="0 3 16 16" align="VCenter" name="BtnR1Image">
                <Property key="Colour" value="#ccb589"/>
                <Property key="Visible" value="false"/>
                <UserString key="Hidden" value="true"/>
            </Widget>
            <!-- The search box: kept hidden (no keyboard while bartering) -->
            <Widget type="EditBox" skin="MW_TextBoxEditWithBorder" position="0 0 0 22" name="FilterEdit">
                <Property key="Visible" value="false"/>
            </Widget>
        </Widget>

        <!-- Items: two rows -->
        <Widget type="ItemView" skin="MW_ItemView" position="4 28 372 92" name="ItemView" align="Left Top"/>

        <Widget type="Widget" skin="" position="4 124 372 84" name="BottomPane" align="Left Top">
            <Widget type="HBox" position="0 0 372 24" align="Left Top">
                <Widget type="Button" skin="MW_Button" position="0 0 32 22" name="IncreaseButton" align="Left Top">
                    <Property key="Caption" value="+"/>
                    <Property key="NeedKey" value="false"/>
                </Widget>
                <Widget type="AutoSizedTextBox" skin="SandText" position="40 0 120 22" name="TotalBalanceLabel" align="Left Top">
                    <Property key="TextAlign" value="Left VCenter"/>
                </Widget>
                <Widget type="Spacer"/>
                <Widget type="AutoSizedTextBox" skin="SandText" position="0 0 180 22" name="PlayerGold" align="Right Top">
                    <Property key="TextAlign" value="Right"/>
                </Widget>
            </Widget>

            <Widget type="HBox" position="0 26 372 26" align="Left Top">
                <Widget type="Button" skin="MW_Button" position="0 0 32 22" name="DecreaseButton" align="Left Top">
                    <Property key="Caption" value="-"/>
                    <Property key="NeedKey" value="false"/>
                </Widget>
                <Widget type="NumericEditBox" skin="MW_TextEdit" position="40 0 120 22" name="TotalBalance" align="Left Top">
                    <Property key="TextAlign" value="Center"/>
                </Widget>
                <Widget type="Spacer"/>
                <Widget type="AutoSizedTextBox" skin="SandText" position="0 0 180 22" name="MerchantGold" align="Right Top">
                    <Property key="TextAlign" value="Right"/>
                </Widget>
            </Widget>

            <Widget type="HBox" position="0 56 372 26" align="Left Top">
                <Widget type="AutoSizedButton" skin="MW_Button" name="MaxSaleButton">
                    <Property key="Caption" value="#{sMaxSale}"/>
                </Widget>
                <Widget type="Spacer"/>
                <Widget type="AutoSizedButton" skin="MW_Button" name="OfferButton">
                    <Property key="Caption" value="#{sBarterDialog8}"/>
                </Widget>
                <Widget type="AutoSizedButton" skin="MW_Button" name="CancelButton">
                    <Property key="Caption" value="#{Interface:Cancel}"/>
                </Widget>
            </Widget>
        </Widget>
    </Widget>
</MyGUI>
