<?xml version="1.0" encoding="UTF-8"?>

<!-- The save/load dialog on the top screen (M8, the tester's design): the character box (loading) and the
     saves list on the left, the save's details on the right, the name box (saving: a touch opens
     the system keyboard) and Delete/OK/Cancel along the bottom. The widget names are those of
     savegamedialog.cpp. -->
<MyGUI type="Layout">
    <Widget type="Window" skin="MW_DialogNoTransp" layer="Modal" position="0 0 400 240" name="_Main">
        <Widget type="ComboBox" skin="MW_ComboBox" position="8 6 204 22" name="SelectCharacter">
            <Property key="Caption" value="#{OMWEngine:SelectCharacter}"/>
            <Property key="ModeDrop" value="true"/>
        </Widget>
        <Widget type="ListBox" skin="MW_List" position="8 32 204 142" name="SaveList">
        </Widget>

        <!-- A save has no picture on the 3DS (StateManager::writeScreenshot is empty there): the details take the
             column, the place's name above the rest whatever its number of lines (M17: test #96's overlapped). -->
        <Widget type="ImageBox" skin="ImageBox" position="0 0 1 1" name="Screenshot">
            <Property key="Visible" value="false"/>
        </Widget>
        <Widget type="VBox" position="220 8 172 166">
            <Property key="Spacing" value="4"/>
            <Widget type="AutoSizedEditBox" skin="NormalText" name="CellName">
                <UserString key="HStretch" value="true"/>
                <Property key="Static" value="true"/>
                <Property key="MultiLine" value="true"/>
                <Property key="WordWrap" value="true"/>
                <Property key="TextAlign" value="Left Top"/>
            </Widget>
            <Widget type="AutoSizedEditBox" skin="SandText" name="InfoText">
                <UserString key="HStretch" value="true"/>
                <Property key="Static" value="true"/>
                <Property key="MultiLine" value="true"/>
                <Property key="WordWrap" value="true"/>
                <Property key="TextAlign" value="Left Top"/>
            </Widget>
            <Widget type="Spacer"/>
        </Widget>

        <Widget type="EditBox" skin="MW_TextEdit" position="8 180 384 22" name="SaveNameEdit">
            <Property key="Static" value="true"/>
        </Widget>
        <Widget type="HBox" skin="" position="8 206 384 26">
            <Widget type="AutoSizedButton" skin="MW_Button" name="DeleteButton">
                <Property key="Caption" value="#{OMWEngine:DeleteGame}"/>
            </Widget>
            <Widget type="Spacer"/>
            <Widget type="AutoSizedButton" skin="MW_Button" name="OkButton">
                <Property key="Caption" value="#{Interface:OK}"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" name="CancelButton">
                <Property key="Caption" value="#{Interface:Cancel}"/>
            </Widget>
        </Widget>
    </Widget>
</MyGUI>
