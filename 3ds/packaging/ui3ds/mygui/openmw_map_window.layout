<?xml version="1.0" encoding="UTF-8"?>

<!--
  Nintendo 3DS: OpenMW's map window (mwgui/mapwindow.cpp) as the bottom screen's full map, opened by tapping the
  minimap (GM_Map3DS, Options > Experimental): the whole bottom screen above the button hint strip (canvas 40, 240,
  320x222), the game paused. The maps pan with the stylus (OpenMW's drag), B closes, X switches local and world, Y
  centres on the player. Same widget names as OpenMW's layout.
-->
<MyGUI type="Layout">
    <Widget type="Window" skin="MW_Page3DS" layer="Windows" position="40 240 320 222" name="_Main">
        <Property key="MinSize" value="40 40"/>

        <!-- Local map -->
        <Widget type="ScrollView" skin="MW_MapView" position="0 0 312 214" align="Stretch" name="LocalMap">
            <Widget type="ImageBox" skin="RotatingSkin" position="0 0 32 32" align="Top Left" name="CompassLocal">
                <Property key="ImageTexture" value="textures\compass.dds"/>
            </Widget>

            <Widget type="Button" skin="" position_real="0 0 1 1" name="EventBoxLocal" align="Stretch">
                <Property key="Depth" value="10"/>
            </Widget>
        </Widget>

        <!-- Global map -->
        <Widget type="ScrollView" skin="MW_MapView" position="0 0 312 214" align="Stretch" name="GlobalMap">
            <Widget type="ImageBox" skin="ImageBox" position_real="0 0 1 1" align="Stretch" name="GlobalMapImage">
                <Widget type="ImageBox" skin="ImageBox" position_real="0 0 1 1" align="Stretch" name="GlobalMapOverlay"/>
            </Widget>

            <Widget type="ImageBox" skin="RotatingSkin" position="0 0 32 32" align="Top Left" name="CompassGlobal">
                <Property key="ImageTexture" value="textures\compass.dds"/>
            </Widget>

            <Widget type="Button" skin="" position_real="0 0 1 1" name="EventBoxGlobal" align="Stretch"/>
        </Widget>

        <!-- Local / World, a tap away -->
        <Widget type="AutoSizedButton" skin="MW_Button" position="245 186 61 22" align="Bottom Right" name="WorldButton">
            <Property key="ExpandDirection" value="Left"/>
            <Property key="NeedKey" value="false"/>
        </Widget>
    </Widget>
</MyGUI>
