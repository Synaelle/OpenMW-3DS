<?xml version="1.0" encoding="UTF-8"?>

<!-- The pick-class window on the top screen (M8, 3DS): 400x240 at 0,0 (center() keeps a screen-wide window in
     place). The widget names are those of class.cpp. -->
<MyGUI type="Layout">
    <Widget type="Window" skin="MW_Dialog" layer="Modal" position="0 0 400 240" name="_Main">
        <!-- Class list -->
        <Widget type="ListBox" skin="MW_List" position="8 4 140 96" name="ClassList"/>

        <!-- Class image -->
        <Widget type="Widget" skin="MW_Box" position="156 4 236 96" align="Left Top">
            <Widget type="ImageBox" skin="ImageBox" position="2 2 232 92" name="ClassImage" align="Left Top"/>
        </Widget>

        <Widget type="Widget" skin="" position="8 104 384 104" align="Left Top">
            <!-- Specialization -->
            <Widget type="TextBox" skin="HeaderText" position="0 0 144 17" name="SpecializationT" align="Left Top">
                <Property key="Caption" value="#{sChooseClassMenu1}"/>
                <Property key="TextAlign" value="Left Top"/>
            </Widget>
            <Widget type="TextBox" skin="SandText" position="0 17 144 17" name="SpecializationName" align="Left Top">
                <Property key="TextAlign" value="Left Top"/>
            </Widget>

            <!-- Favorite Attributes -->
            <Widget type="TextBox" skin="HeaderText" position="0 38 144 17" name="FavoriteAttributesT" align="Left Top">
                <Property key="Caption" value="#{sChooseClassMenu2}"/>
                <Property key="TextAlign" value="Left Top"/>
            </Widget>
            <Widget type="MWAttribute" skin="MW_StatNameButton" position="0 55 144 17" name="FavoriteAttribute0" align="Left Top"/>
            <Widget type="MWAttribute" skin="MW_StatNameButton" position="0 72 144 17" name="FavoriteAttribute1" align="Left Top"/>

            <!-- Major Skills -->
            <Widget type="TextBox" skin="HeaderText" position="144 0 120 17" name="MajorSkillT" align="Left Top">
                <Property key="TextAlign" value="Left Top"/>
                <Property key="Caption" value="#{sChooseClassMenu3}"/>
            </Widget>
            <Widget type="MWSkill" skin="MW_StatName" position="144 17 120 17" name="MajorSkill0" align="Left Top"/>
            <Widget type="MWSkill" skin="MW_StatName" position="144 34 120 17" name="MajorSkill1" align="Left Top"/>
            <Widget type="MWSkill" skin="MW_StatName" position="144 51 120 17" name="MajorSkill2" align="Left Top"/>
            <Widget type="MWSkill" skin="MW_StatName" position="144 68 120 17" name="MajorSkill3" align="Left Top"/>
            <Widget type="MWSkill" skin="MW_StatName" position="144 85 120 17" name="MajorSkill4" align="Left Top"/>

            <!-- Minor Skills -->
            <Widget type="TextBox" skin="HeaderText" position="264 0 120 17" name="MinorSkillT" align="Left Top">
                <Property key="Caption" value="#{sChooseClassMenu4}"/>
                <Property key="TextAlign" value="Left Top"/>
            </Widget>
            <Widget type="MWSkill" skin="MW_StatName" position="264 17 120 17" name="MinorSkill0" align="Left Top"/>
            <Widget type="MWSkill" skin="MW_StatName" position="264 34 120 17" name="MinorSkill1" align="Left Top"/>
            <Widget type="MWSkill" skin="MW_StatName" position="264 51 120 17" name="MinorSkill2" align="Left Top"/>
            <Widget type="MWSkill" skin="MW_StatName" position="264 68 120 17" name="MinorSkill3" align="Left Top"/>
            <Widget type="MWSkill" skin="MW_StatName" position="264 85 120 17" name="MinorSkill4" align="Left Top"/>
        </Widget>

        <!-- Dialog buttons -->
        <Widget type="HBox" position="0 210 392 26">
            <Widget type="Spacer"/>
            <Widget type="AutoSizedButton" skin="MW_Button" name="BackButton">
                <Property key="Caption" value="#{sBack}"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" name="OKButton">
                <Property key="Caption" value="#{Interface:OK}"/>
            </Widget>
        </Widget>
    </Widget>
</MyGUI>
