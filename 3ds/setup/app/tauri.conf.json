{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMW 3DS Setup",
  "mainBinaryName": "openmw3ds-setup",
  "identifier": "io.github.synaelle.openmw3ds.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenMW for New 3DS setup",
        "width": 720,
        "height": 480,
        "minWidth": 600,
        "minHeight": 440,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage"],
    "category": "Utility",
    "shortDescription": "Prepares OpenMW for New 3DS from your Morrowind",
    "longDescription": "Prepares the folder to copy to a New 3DS's SD card from your own Morrowind installation.",
    "copyright": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
