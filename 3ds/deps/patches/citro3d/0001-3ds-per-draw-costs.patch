@@ -40,6 +40,18 @@ void C3D_UpdateUniforms(GPU_SHADER_TYPE type)
 	// Update FVec uniforms
 	while (i < C3D_FVUNIF_COUNT)
 	{
+		// OpenMW 3DS port: clean flags skipped four at a time (a draw changes a few of the 96, and this runs for
+		// both shader types before every draw).
+		if ((i & 3) == 0)
+		{
+			u32 four;
+			memcpy(&four, &C3D_FVUnifDirty[type][i], sizeof(four));
+			if (!four)
+			{
+				i += 4;
+				continue;
+			}
+		}
 		if (!C3D_FVUnifDirty[type][i])
 		{
 			i ++;
