diff --git a/source/internal.h b/source/internal.h
index 3ccab72..14a03f9 100644
--- a/source/internal.h
+++ b/source/internal.h
@@ -1,4 +1,5 @@
 #pragma once
+#include <string.h>
 #include <c3d/attribs.h>
 #include <c3d/buffers.h>
 #include <c3d/proctex.h>
@@ -158,3 +159,19 @@ void C3Di_RenderQueueExit(void);
 void C3Di_RenderQueueWaitDone(void);
 void C3Di_RenderQueueEnableVBlank(void);
 void C3Di_RenderQueueDisableVBlank(void);
+
+// OpenMW 3DS port: single-parameter register writes as (param, header) pairs, the layout GPUCMD_Add writes for one
+// parameter, added with one copy when they fit (else one by one through GPUCMD_Add, which breaks when full).
+#define C3Di_CMD(reg, mask, val) (u32)(val), GPUCMD_HEADER(0, (mask), (reg))
+static inline void C3Di_AddSingleWrites(const u32* cmds, u32 words)
+{
+	if (gpuCmdBuf && gpuCmdBufOffset + words <= gpuCmdBufSize)
+	{
+		memcpy(&gpuCmdBuf[gpuCmdBufOffset], cmds, words * sizeof(u32));
+		gpuCmdBufOffset += words;
+		return;
+	}
+	u32 k;
+	for (k = 0; k < words; k += 2)
+		GPUCMD_Add(cmds[k + 1], &cmds[k], 1);
+}
